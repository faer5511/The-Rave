# Скопируйте в .env и поправьте
DATABASE_URL=sqlite:///./data/rave.db
PUBLIC_BASE_URL=http://localhost:8000
# Use a persistent random value (32+ characters); start.sh replaces this placeholder.
SECRET_KEY=change-me-to-long-random-string
HOLD_MINUTES=15

# mock = заглушка оплаты без ключей; yookassa = ЮKassa (тестовый магазин — тестовые ключи)
PAYMENT_MODE=mock
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Required for account registration and email verification.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=tickets@example.com
YOOKASSA_SEND_RECEIPT=false
SMTP_USE_SSL=false

# Пароль входа в /admin (придумайте длинный). Без него админка выключена
ADMIN_PASSWORD=
ADMIN_LOGIN=admin

# Подтверждение email новых пользователей
VERIFICATION_HOURS=24
SESSION_HOURS=12
